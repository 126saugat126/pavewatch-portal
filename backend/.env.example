# Copy to backend/.env and adjust. All settings are optional; defaults suit local development.

# Database (SQLAlchemy URL). Default: SQLite file in backend/data/
# PW_DATABASE_URL=sqlite:///./data/pavewatch.db
# Cloud SQL for PostgreSQL example (needs `pip install psycopg[binary]`):
# PW_DATABASE_URL=postgresql+psycopg://user:password@host:5432/pavewatch

# Evidence file storage. Only "local" is implemented today ("gcs" planned).
# PW_STORAGE_BACKEND=local
# PW_STORAGE_DIR=./data/files

# Require this key in the X-API-Key header on ingestion endpoints (empty = no key).
# PW_INGEST_API_KEY=change-me

# Max size of one uploaded evidence file, in MB.
# PW_MAX_UPLOAD_MB=50

# PDF reports: OpenStreetMap streets under report maps (false = plain site plan, no network use).
# PW_REPORT_BASEMAP=true
# PW_REPORT_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Frontend dev-server origins allowed by CORS (JSON list).
# PW_CORS_ORIGINS=["http://localhost:5173"]
